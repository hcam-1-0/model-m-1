  "maximum_remediation_validation_and_reseal_cycles": 8,
  "maximum_local_checkpoint_commits_without_push": 4,
  "stop_conditions": [
    "any_bound_input_path_byte_count_or_SHA_256_mismatch",
    "any_change_outside_the_exact_allowlists",
    "any_dependency_resolution_download_install_update_lockfile_SBOM_or_dependency_evidence_change",
    "any_required_product_source_remediation_outside_the_explicit_existing_file_allowlist",
    "any_external_network_provider_Sentinel_camera_tile_media_telemetry_or_real_data_access",
    "any_secret_credential_identity_Government_private_or_prohibited_data_encounter",
    "any_model_dataset_artifact_inference_container_Kubernetes_deployment_or_operational_action_need",
    "any_browser_download_or_unapproved_engine_execution",
    "any_unresolved_blocker_critical_failure_unexplained_skip_unknown_terminal_state_or_relaxed_hard_budget",
    "any_false_production_accessibility_security_compliance_capacity_hardware_reproducibility_SLSA_or_release_claim",
    "eight_remediation_cycles_or_four_local_checkpoint_commits_exhausted",
    "any_need_for_remote_Git"
  ],
  "continuing_prohibitions": [
    "source_import_or_non_allowlisted_product_source_change",
    "new_dependency_resolution_download_install_update_or_lockfile_change",
    "backend_route_or_migration",
    "external_provider_network_Sentinel_camera_tile_media_or_telemetry_access",
    "Government_police_private_personal_biometric_vehicle_owner_registration_watchlist_case_investigation_evidence_or_identity_data",
    "credential_or_secret_access_resolution_entry_test_rotation_or_transmission",
    "model_dataset_artifact_inference_training_or_AI_runtime",
    "operational_alert_notification_dispatch_enforcement_administrative_mutation_or_autonomous_action",
    "scanner_backup_restore_recovery_hardware_performance_stress_or_thermal_execution",
    "container_Kubernetes_execution_or_deployment",
    "production_pilot_accessibility_security_compliance_capacity_hardware_reproducibility_SLSA_or_release_claim",
    "final_Phase_5_acceptance_without_separate_exact_owner_gate",
    "push_pull_fetch_PR_merge_release_or_other_remote_Git"
  ]
