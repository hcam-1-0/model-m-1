{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"hcam.phase5.p5_2.command_projection.v1","title":"Generated Command Projection","type":"object","additionalProperties":false,"required":["contract_version","marker","department_ref","revision","freshness","metrics","work_items","activity","unavailable_producers"],"properties":{"contract_version":{"const":"1.0.0"},"marker":{"const":"HCAM-GENERATED-NON-OPERATIONAL"},"department_ref":{"type":"string","pattern":"^SYN-[A-Z0-9-]{3,48}$"},"revision":{"type":"string","maxLength":64},"freshness":{"type":"object"},"metrics":{"type":"array","maxItems":24},"work_items":{"type":"array","maxItems":100},"activity":{"type":"array","maxItems":100},"unavailable_producers":{"type":"array","minItems":14,"maxItems":14,"uniqueItems":true}}}
