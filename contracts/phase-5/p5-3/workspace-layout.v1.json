{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcam:phase5:p5-3:workspace-layout:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "revision", "etag", "columns", "tiles", "generated"],
  "properties": {
    "id": { "type": "string", "pattern": "^SYN-[A-Z0-9-]{3,48}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "revision": { "type": "integer", "minimum": 1 },
    "etag": { "type": "string", "pattern": "^SYN-[A-Z0-9-]{3,48}$" },
    "columns": { "type": "integer", "minimum": 1, "maximum": 4 },
    "tiles": { "type": "array", "maxItems": 10, "items": { "type": "object", "additionalProperties": false, "required": ["tile_id", "stream_ref", "order"], "properties": { "tile_id": { "type": "string" }, "stream_ref": { "type": ["string", "null"] }, "order": { "type": "integer", "minimum": 0 } } } },
    "generated": { "const": true }
  },
  "x-hcam-persistence": "display_preferences_only"
}
