{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcam:phase5:p5-3:media-profile:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "max_streams", "preferred_rendition", "max_fps", "recovery_concurrency", "authority_invariant"],
  "properties": {
    "id": { "enum": ["low_resource", "enhanced_workstation", "control_room", "owned_gpu_lab", "future_server"] },
    "max_streams": { "type": "integer", "minimum": 1, "maximum": 10 },
    "preferred_rendition": { "enum": ["low", "medium", "high"] },
    "max_fps": { "type": "integer", "minimum": 1, "maximum": 30 },
    "recovery_concurrency": { "type": "integer", "minimum": 1, "maximum": 4 },
    "authority_invariant": { "const": "view_only" }
  }
}
