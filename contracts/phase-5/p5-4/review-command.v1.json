{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:hcam:p5-4:review-command:v1","title":"P5.4 review command","type":"object","additionalProperties":false,"required":["alert_ref","outcome","reason_code","expected_revision","if_match","idempotency_key","canonical_fingerprint","policy_revision"],"properties":{"alert_ref":{"type":"string","pattern":"^SYN-ALERT-"},"outcome":{"enum":["confirm_for_record","reject","abstain","request_more_context"]},"reason_code":{"type":"string","maxLength":64},"expected_revision":{"type":"integer","minimum":1},"if_match":{"type":"string","pattern":"^\"SYN-ETAG-[0-9]+\"$"},"idempotency_key":{"type":"string","pattern":"^SYN-IDEMP-"},"canonical_fingerprint":{"type":"string","pattern":"^[A-F0-9]{64}$"},"policy_revision":{"type":"string","pattern":"^SYN-POLICY-"}}}
