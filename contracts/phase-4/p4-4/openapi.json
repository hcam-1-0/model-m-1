    ],
    "/reference-integrations/controls": [
      "GET",
      "POST"
    ],
    "/reference-integrations/health": [
      "GET"
    ],
    "/reference-integrations/providers": [
      "GET",
      "POST"
    ],
    "/reference-integrations/providers/{provider_version_id}": [
      "GET"
    ],
    "/reference-integrations/queries": [
      "POST"
    ],
    "/reference-integrations/queries/{job_id}": [
      "GET"
    ],
    "/reference-integrations/queries/{job_id}/cancel": [
      "POST"
    ]
  },
  "request_requirements": [
    "authenticated exact capability role",
