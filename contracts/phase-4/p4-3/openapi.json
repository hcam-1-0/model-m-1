    "department scope",
    "X-HCAM-Reason",
    "If-Match",
    "typed bounded body"
  ],
  "cache_policy": "no-store",
  "generated_only": true,
  "operational": false,
  "default_enabled": false,
  "production_allowed": false,
  "absent_surfaces": [
    "public proposal or evaluation ingress",
    "automatic rule activation",
