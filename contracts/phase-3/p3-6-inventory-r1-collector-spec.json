    "binding_rule": "future_capacity_or_placement_may_reference_only_this_digest_after_explicit_owner_acceptance_and_separate_admission_authority",
    "policy_digest_grants_execution": false
  },
  "transaction_bounds": {
    "maximum_authorized_attempts": 1,
    "authorization_use_window_seconds_after_owner_acceptance": 86400,
    "per_action_timeout_seconds": 10,
    "total_transaction_timeout_seconds": 60,
