      "preemption": "unknown",
      "gang_scheduling": "unknown"
    },
    "findings_rule": "emit_only_shared_bounded_codes_for_unreported_instruction_sets_accelerator_capacity_optional_runtime_versions_container_state_scheduler_state_and_seven_redacted_categories",
    "redaction": {
      "policy_version": "hcam-sanitized-node-inventory/v1",
      "omitted_categories": [
        "hostname",
        "user_identity",
        "serial_number",
        "network_address",
        "personal_path",
        "raw_device_identifier",
        "secret_reference"
      ]
    }
  },
  "explicit_unknown_policy": {
    "instruction_sets": "unknown_because_no_CPUID_or_runtime_feature_probe_is_authorized",
    "accelerators": "unknown_because_no_display_GPU_driver_or_compute_provider_query_is_authorized",
