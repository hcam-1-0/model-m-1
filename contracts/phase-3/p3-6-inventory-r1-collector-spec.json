    "required_output_on_attempt": "sanitized_collection_evidence_even_when_R1_is_not_written"
  },
  "action_allowlist": [
    {
      "action_id": "R1-A01-UTC-CLOCK-START",
      "purpose": "bound_the_local_collection_transaction",
      "exact_action": "read_[DateTimeOffset]::UtcNow_in_process_memory",
      "persisted_projection": "none"
    },
    {
      "action_id": "R1-A02-WINDOWS-OS-MEMORY",
      "purpose": "collect_minimized_operating_system_and_memory_facts",
      "exact_action": "Get-CimInstance -ClassName Win32_OperatingSystem -Property Version,BuildNumber,OSArchitecture,TotalVisibleMemorySize,FreePhysicalMemory -OperationTimeoutSec 10",
      "required_locality": "omit_ComputerName_and_CimSession",
      "allowed_source_fields": [
        "Version",
        "BuildNumber",
        "OSArchitecture",
        "TotalVisibleMemorySize",
        "FreePhysicalMemory"
      ],
      "all_other_source_fields": "not_requested_not_accessed_not_projected_not_persisted_and_any_provider_supplied_key_metadata_is_discarded_with_the_source_object"
    },
    {
      "action_id": "R1-A03-CPU",
      "purpose": "collect_minimized_processor architecture and capacity facts",
      "exact_action": "Get-CimInstance -ClassName Win32_Processor -Property Architecture,NumberOfCores,NumberOfLogicalProcessors -OperationTimeoutSec 10",
      "required_locality": "omit_ComputerName_and_CimSession",
      "allowed_source_fields": [
        "Architecture",
        "NumberOfCores",
        "NumberOfLogicalProcessors"
      ],
      "all_other_source_fields": "not_requested_not_accessed_not_projected_not_persisted_and_any_provider_supplied_key_metadata_is_discarded_with_the_source_object"
    },
    {
      "action_id": "R1-A04-PYTHON-VERSION",
      "purpose": "read_the_default_python_compatibility_family_if_available",
      "exact_action": "python -I -S -c \"import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}')\"",
      "allowed_output": "one_version_family_line_only",
      "imports_allowed": [
        "sys"
      ],
      "target_runtime_or_model_import_allowed": false
    },
    {
      "action_id": "R1-A05-ONNXRUNTIME-DISTRIBUTION-VERSION",
      "purpose": "read_installed_distribution_metadata_without_loading_the_runtime",
      "exact_action": "python -I -S -c \"import sys,sysconfig; paths={sysconfig.get_path('purelib'),sysconfig.get_path('platlib')}; sys.path.extend(sorted(path for path in paths if path)); from importlib.metadata import version; print(version('onnxruntime'))\"",
      "allowed_output": "one_version_family_line_or_bounded_unavailable_code",
      "imports_allowed": [
        "importlib.metadata"
      ],
      "target_runtime_or_model_import_allowed": false,
      "package_files_paths_dependencies_entry_points_or_origin_allowed": false
    },
    {
      "action_id": "R1-A06-FFMPEG-VERSION",
      "purpose": "read_ffmpeg_version_metadata_without_media_access",
      "exact_action": "ffmpeg -version",
      "allowed_output": "parse_only_the_first_line_into_a_version_family_then_discard_all_raw_output",
      "media_input_output_device_protocol_or_probe_allowed": false,
      "build_configuration_persisted": false
    },
    {
      "action_id": "R1-A07-OPAQUE-ID",
      "purpose": "create_a_non_identifying_snapshot_id",
      "exact_action": "generate_24_lowercase_hex_characters_from_the_operating_system_cryptographic_random_source_and_prefix_inv_",
      "persisted_projection": "inventory_id_only",
      "identity_or_hardware_input_allowed": false
    },
    {
      "action_id": "R1-A08-UTC-CLOCK-COMPLETE",
      "purpose": "set_the_observation_and_expiry_boundary_after_successful_source_reads",
      "exact_action": "read_[DateTimeOffset]::UtcNow_once_as_observed_at_and_compute_valid_until_as_exactly_observed_at_plus_86400_seconds",
      "persisted_projection": "observed_at_and_valid_until_in_UTC"
    },
    {
      "action_id": "R1-A09-NORMALIZE-VALIDATE-HASH-WRITE",
      "purpose": "create_only_sanitized_contract_and_evidence_outputs",
      "exact_action": "normalize_allowlisted_values_in_memory_validate_against_the_exact_shared_schema_serialize_with_hcam_canonical_json_v1_compute_SHA_256_write_R1_atomically_then_write_sanitized_evidence_atomically",
      "filesystem_reads_allowed": [
        "exact_shared_schema_path",
        "exact_trust_policy_path"
      ],
      "filesystem_writes_allowed": [
        "contracts/phase-3/p3-6-inventory-lab-laptop-01-r1.json",
        "contracts/phase-3/p3-6-inventory-r1-collection-evidence.json"
      ],
      "other_reads_or_writes_allowed": false
    }
  ],
  "projection_rules": {
    "schema_version": "hcam.platform.node-capability-inventory/v1alpha1",
    "inventory_id": "R1_A07_opaque_identifier",
    "observed_at": "R1_A08_completion_timestamp",
    "valid_until": "observed_at_plus_exactly_86400_seconds",
    "provenance": {
      "collection_mode": "local_read_only",
      "trust_level": "observed",
      "collector_version": "hcam-p36-r1-spec-1.0.0"
    },
    "node_class": "cpu_laptop",
    "operating_system": {
      "state": "supported_only_when_all_required_OS_fields_normalize_without_conflict_otherwise_abort_without_R1",
      "family": "windows",
      "architecture": "normalize_from_OSArchitecture_and_numeric_processor_architecture_with_conflicts_failing_closed",
      "version_family": "sanitized_Version_plus_build_BuildNumber_with_only_shared_version_family_characters"
    },
    "cpu": {
      "state": "supported_only_when_architecture_core_and_logical_counts_are_complete_and_consistent_otherwise_abort_without_R1",
      "architecture_mapping": {
        "0": "x86",
        "9": "amd64",
        "12": "arm64",
        "other_documented_or_unrecognized": "other"
      },
      "logical_processors": "sum_NumberOfLogicalProcessors_across_returned_processor_instances",
      "physical_cores": "sum_NumberOfCores_across_returned_processor_instances",
      "instruction_sets": [
        "unknown"
      ]
    },
    "memory": {
      "state": "supported_only_when_total_and_available_values_are_present_nonnegative_and_available_is_not_greater_than_total_otherwise_abort_without_R1",
      "total_mib": "floor_TotalVisibleMemorySize_kilobytes_divided_by_1024",
      "available_mib": "floor_FreePhysicalMemory_kilobytes_divided_by_1024"
    },
    "accelerators": {
      "state": "unknown",
      "items": []
    },
    "runtimes": {
      "state": "unknown",
      "items_rule": "include_only_successfully_parsed_python_onnxruntime_and_ffmpeg_version_families_with_each_item_state_unknown_and_no_compatibility_claim",
      "python_backends": [
        "unknown"
      ],
      "onnxruntime_backends": [
        "unknown"
      ],
      "ffmpeg_backends": [
        "cpu"
      ]
    },
    "container_support": {
      "state": "unknown",
      "engines": [],
