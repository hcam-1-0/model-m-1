  "decisions": [
    {
      "decision_id": "D-P3.6-U4E-001",
      "title": "Manifest Relative-Path Resolution",
      "recommended_option": "A",
      "options": {
        "A": {
          "label": "Field-aware manifest-directory resolution",
          "effect": "anchor_relative_direct_file_references_to_the_exact_manifest_directory_then_canonicalize_and_require_containment_under_the_exact_module_root_and_PSHome",
          "tradeoff": "matches_official_manifest_semantics_while_preserving_fail_closed_path_reparse_size_count_and_trust_bounds"
        },
        "B": {
          "label": "Retain PSHome-relative resolution",
          "effect": "continue_resolving_every_relative_entry_from_PSHome",
          "tradeoff": "smallest_change_but_conflicts_with_documented_manifest_relative_path_semantics_and_may_repeat_the_failure"
        },
        "C": {
          "label": "Delegate resolution to module import",
          "effect": "use_Test_ModuleManifest_or_Import_Module_to_interpret_the_manifest",
          "tradeoff": "expands_from_literal_parse_and_path_binding_into_semantic_evaluation_or_module_loading"
        },
        "D": {
          "label": "Permit arbitrary path forms",
          "effect": "allow_absolute_URI_wildcard_expression_or_out_of_root_references",
          "tradeoff": "breaks_the_exact_local_containment_and_fail_closed_security_boundary"
        }
      }
    },
    {
      "decision_id": "D-P3.6-U4E-002",
      "title": "Closure Requiredness And FileList",
      "recommended_option": "A",
      "options": {
        "A": {
          "label": "Typed load-bearing closure plus bounded inventory",
          "effect": "require_every_RootModule_path_valued_NestedModules_RequiredAssemblies_TypesToProcess_and_FormatsToProcess_target_then_treat_FileList_as_a_separate_inventory_surface_with_code_like_entries_strict_and_missing_non_load_bearing_entries_counted_without_path_retention",
          "tradeoff": "avoids_false_runtime_closure_failures_without_weakening_any_load_bearing_target_or_trust_gate"
        },
        "B": {
          "label": "Require every declared entry equally",
          "effect": "treat_all_FileList_and_load_bearing_entries_as_identical_hard_runtime_dependencies",
          "tradeoff": "simpler_but_can_block_on_an_informational_non_runtime_inventory_entry"
        },
        "C": {
          "label": "Ignore FileList completely",
          "effect": "exclude_all_FileList_entries_from_binding_and_evidence",
          "tradeoff": "avoids_inventory_false_positives_but_loses_package_inventory_and_code_like_file_attestation"
        },
        "D": {
          "label": "Allow missing load-bearing targets",
          "effect": "continue_when_RootModule_assembly_type_format_or_nested_module_targets_are_missing",
          "tradeoff": "could_accept_an_incomplete_or_tampered_runtime_module"
        }
      }
    },
    {
      "decision_id": "D-P3.6-U4E-003",
      "title": "Pre-Runtime Resolver Evidence",
      "recommended_option": "A",
      "options": {
        "A": {
          "label": "Generated resolver contract and machine-disabled oracle",
          "effect": "implement_an_additive_typed_resolver_contract_PowerShell_source_machine_disabled_Python_reference_and_at_least_512_generated_manifest_vectors_for_field_base_containment_requiredness_and_boundary_semantics",
          "tradeoff": "largest_source_only_validation_set_but_minimizes_the_risk_of_consuming_another_machine_attempt"
        },
        "B": {
          "label": "Patch the R2 runner inline",
          "effect": "change_only_the_existing_closure_binding_logic_with_source_text_checks",
          "tradeoff": "smaller_diff_but_weaker_cross_language_and_generated_behavior_evidence"
        },
        "C": {
          "label": "Run a separate live-manifest diagnostic first",
          "effect": "authorize_another_machine_observation_to_classify_the_missing_field_and_target",
          "tradeoff": "could_localize_the_installed_state_but_adds_an_attempt_and_machine_data_boundary_before_source_remediation"
        },
        "D": {
          "label": "Retry the unchanged R2 package",
          "effect": "run_the_same_resolution_policy_again",
          "tradeoff": "the_consumed_authorization_cannot_be_reused_and_the_deterministic_failure_is_expected_to_repeat"
        }
      }
    },
    {
      "decision_id": "D-P3.6-U4E-004",
      "title": "Historical Evidence And Remediation Shape",
      "recommended_option": "A",
      "options": {
        "A": {
          "label": "Additive U4F remediation with immutable R2 history",
          "effect": "preserve_every_R2_record_and_accepted_U4D_input_byte_exact_and_add_new_contract_source_vectors_tests_evidence_and_R3_package_paths",
          "tradeoff": "maintains_auditable_failure_history_and_limits_compatibility_edits_to_exact_hash_bound_transitions"
        },
        "B": {
          "label": "Modify the R2 action specification in place",
          "effect": "rewrite_the_consumed_package_to_describe_the_new_resolution_behavior",
          "tradeoff": "invalidates_the_digest_bound_authorization_and_failed_attempt_evidence"
        },
        "C": {
          "label": "Reclassify R2 as partial success",
          "effect": "credit_runtime_binding_and_manifest_parsing_as_a_successful_closeout",
          "tradeoff": "contradicts_the_required_all_gates_success_contract_and_would_hide_the_failed_closure_gate"
        },
        "D": {
          "label": "Broaden remediation into models or deployment",
          "effect": "combine_manifest_closure_remediation_with_artifact_model_Kubernetes_or_deployment_work",
          "tradeoff": "expands_scope_without_resolving_the_narrow_closeout_blocker"
        }
      }
    },
    {
      "decision_id": "D-P3.6-U4E-005",
      "title": "Authorization And Runtime Reentry",
      "recommended_option": "A",
      "options": {
        "A": {
          "label": "One source-build authorization then one R3 runtime authorization",
          "effect": "use_one_bounded_source_only_U4F_build_with_limited_revision_cycles_then_one_exact_final_digest_bound_single_R3_closeout_attempt",
          "tradeoff": "keeps_two_owner_gates_and_prevents_runtime_authority_from_preceding_final_source_and_evidence_digests"
        },
        "B": {
          "label": "Combine source build and runtime execution",
          "effect": "authorize_remediation_implementation_and_machine_execution_before_final_source_hashes_exist",
          "tradeoff": "faster_but_weakens_the_reviewable_source_to_runtime_boundary"
        },
        "C": {
          "label": "Add a diagnostic attempt before R3",
          "effect": "require_source_build_then_read_only_live_manifest_diagnostic_then_closeout_attempt",
          "tradeoff": "more_precise_machine_evidence_but_adds_a_third_owner_gate_and_another_attempt"
        },
        "D": {
          "label": "Stop runtime closeout",
          "effect": "retain_R2_failed_closed_evidence_without_further_machine_attempts",
          "tradeoff": "no_new_machine_risk_but_P3_6_and_Phase_3_remain_incomplete"
        }
      }
