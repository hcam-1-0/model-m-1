  "decisions": [
    {
      "decision_id": "D-P3.6-U3U-001",
      "title": "First Remediation Surface",
      "recommended_option": "A",
      "options": {
        "A": {
          "label": "Additive H1 R1 diagnostic harness",
          "effect": "Preserve_the_accepted_controller_and_historical_H1_byte_exact_then_implement_later_a_new_package_bound_H1_R1_harness_with_typed_field_group_diagnostics",
          "tradeoff": "isolates_the_unobserved_predicate_without_changing_the_controller_that_already_passed_its_generated_static_contract"
        },
        "B": {
          "label": "Modify the controller first",
          "effect": "Change_the_accepted_controller_output_before_the_failed_H1_predicate_is_identified",
          "tradeoff": "may_fix_the_issue_but_guesses_at_root_cause_and_invalidates_more_accepted_evidence"
        },
        "C": {
          "label": "Modify both controller and H1",
          "effect": "Create_a_new_controller_and_harness_contract_together",
          "tradeoff": "largest_blast_radius_and_makes_it_harder_to_identify_which_change_resolved_the_failure"
        },
        "D": {
          "label": "Stop U3T remediation",
          "effect": "Keep_U3T_and_U3K_blocked_without_new_source_or_runtime_work",
          "tradeoff": "no_new_risk_but_no_Phase_3_6_runtime_validation_progress"
        }
      }
    },
    {
      "decision_id": "D-P3.6-U3U-002",
      "title": "Sanitized Diagnostic Contract",
      "recommended_option": "A",
