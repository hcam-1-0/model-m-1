          "effect": "Require_generated_vectors_for_every_allowlisted_result_group_controller_reason_family_redaction_bound_and_fail_closed_transition_and_compare_the_H1_contract_to_the_machine_disabled_Python_oracle_without_machine_access",
          "tradeoff": "largest_source_only_test_effort_but_best_pre_runtime_coverage"
        },
        "B": {
          "label": "Static token and hash checks only",
          "effect": "Verify_source_markers_hashes_and_embedded_JSON_without_differential_result_vectors",
          "tradeoff": "faster_but_repeats_the_evidence_gap_that_allowed_U3T_R1_to_fail"
        },
        "C": {
          "label": "PowerShell execution as implementation evidence",
          "effect": "Execute_the_new_harness_before_separate_source_acceptance",
          "tradeoff": "faster_feedback_but_collapses_the_source_acceptance_and_runtime_authorization_gates"
        },
        "D": {
          "label": "No validation package",
          "effect": "Do_not_prepare_generated_or_static_evidence",
