          "effect": "Emit_only_one_allowlisted_reason_for_top_level_shape_identity_terminal_success_reason_stage_counts_retention_or_gate_group_mismatch_plus_an_allowlisted_controller_reason_family",
          "tradeoff": "provides_actionable_isolation_without_retaining_values_types_raw_output_or_exceptions"
        },
        "B": {
          "label": "Bounded mismatch bitset",
          "effect": "Emit_a_fixed_boolean_vector_for_each_result_group_without_values",
          "tradeoff": "more_compact_but_less_human_readable_and_easier_to_misinterpret_across_contract_versions"
        },
        "C": {
          "label": "Keep one coarse invalid code",
          "effect": "Retain_only_result_contract_invalid",
          "tradeoff": "preserves_the_current_blind_spot_and_makes_another_attempt_low_value"
        },
        "D": {
          "label": "Retain raw controller output",
          "effect": "Store_the_candidate_projection_or_exception_for_debugging",
          "tradeoff": "highest_diagnostic_detail_but_breaks_the_zero_raw_retention_boundary_and_is_not_recommended"
        }
      }
    },
    {
      "decision_id": "D-P3.6-U3U-003",
      "title": "Source Validation Evidence",
      "recommended_option": "A",
