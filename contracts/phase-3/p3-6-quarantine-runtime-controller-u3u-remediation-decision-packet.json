          "label": "Source acceptance then one diagnostic retry",
          "effect": "First_accept_the_additive_H1_R1_source_and_generated_static_evidence_then_prepare_a_separate_digest_bound_single_generated_only_runtime_diagnostic_and_require_success_acceptance_before_any_U3K_package",
          "tradeoff": "preserves_the_source_first_and_single_attempt_controls_while_producing_actionable_evidence"
