{
  "name": "@hcam/frontend-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "check:toolchain": "node ./scripts/verify-toolchain.mjs",
    "resolve:dependencies": "node ./scripts/resolve-dependencies.mjs",
    "check:workspace": "node ./scripts/verify-workspace.mjs",
    "check:bundles": "node ./scripts/verify-bundles.mjs",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "format:check": "node ./scripts/run-workspace.mjs format-check",
    "typecheck": "node ./scripts/run-workspace.mjs typecheck",
    "test": "node ./node_modules/vitest/vitest.mjs --config vitest.workspace.ts run",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs --config vitest.workspace.ts run --coverage",
    "build": "node ./scripts/run-workspace.mjs build",
    "storybook:build": "node ./scripts/run-workspace.mjs storybook",
    "test:browser": "node ./node_modules/@playwright/test/cli.js test",
    "audit:dependencies": "node ./scripts/capture-dependency-audit.mjs",
    "evidence:dependencies": "node ./scripts/finalize-dependency-evidence.mjs",
    "evidence:validation": "node ./scripts/generate-validation-evidence.mjs",
    "evidence": "node ./scripts/generate-evidence.mjs",
    "p5:7:generate": "node ./scripts/generate-p5-7-cases.mjs",
    "p5:7:test": "node ./node_modules/vitest/vitest.mjs --config vitest.workspace.ts run tests/p5-7-*.test.ts tests/p5-7-*.test.tsx",
    "p5:7:verify": "node ./scripts/verify-p5-7-repeatability.mjs",
    "p5:7:validate": "node ./scripts/run-p5-7-validation.mjs",
    "dev": "node ./scripts/run-workspace.mjs dev command-center",
    "validate": "node ./scripts/run-workspace.mjs validate"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mapbox": "9.4.0",
    "@tanstack/react-query": "5.102.8",
    "ajv": "8.20.0",
    "hls.js": "1.7.2",
    "lucide-react": "1.41.0",
    "maplibre-gl": "6.7.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "react-intl": "10.1.26",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@hcam/api-client": "workspace:*",
    "@hcam/app-shell": "workspace:*",
    "@hcam/auth-session": "workspace:*",
    "@hcam/capabilities": "workspace:*",
    "@hcam/camera-live-domain": "workspace:*",
    "@hcam/command-domain": "workspace:*",
    "@hcam/contracts": "workspace:*",
    "@hcam/design-tokens": "workspace:*",
    "@hcam/event-invalidation": "workspace:*",
    "@hcam/gis-contracts": "workspace:*",
    "@hcam/gis-domain": "workspace:*",
    "@hcam/gis-renderers": "workspace:*",
    "@hcam/i18n": "workspace:*",
    "@hcam/media-adapters": "workspace:*",
    "@hcam/media-edge-contracts": "workspace:*",
    "@hcam/navigation": "workspace:*",
    "@hcam/observability": "workspace:*",
    "@hcam/playback-contracts": "workspace:*",
    "@hcam/query-policy": "workspace:*",
    "@hcam/test-fixtures": "workspace:*",
    "@hcam/test-support": "workspace:*",
    "@hcam/ui": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
